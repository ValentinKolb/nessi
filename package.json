{
  "name": "nessi-monorepo",
  "description": "Minimal agent loop, provider adapters, and browser UI for nessi.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "dev": "bun run --filter nessi-ui dev",
    "build": "bun run --filter nessi-ui build",
    "typecheck": "bun run --filter @valentinkolb/nessi typecheck && bun run --filter nessi-ui typecheck",
    "test": "bun run --filter @valentinkolb/nessi test",
    "test:ai": "bun run --filter @valentinkolb/nessi test:ai",
    "test:core": "bun run --filter @valentinkolb/nessi test:core",
    "build:nessi": "bun run --filter @valentinkolb/nessi build:npm",
    "dev:ui": "bun run --filter nessi-ui dev",
    "build:ui": "bun run --filter nessi-ui build",
    "preview:ui": "bun run --filter nessi-ui preview"
  }
}
